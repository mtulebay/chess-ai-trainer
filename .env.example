# --- Обязательно ---
CHESSCOM_USERNAME=your_nick
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# --- Разбор (LLM) ---
# auto: если задан ANTHROPIC_API_KEY -> api, иначе если есть `claude` в PATH -> claude-cli, иначе none (сырой отчёт без LLM)
LLM_BACKEND=auto
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# --- Движок ---
# Пусто = искать сам (PATH, /usr/games, ./bin). `python -m chess_trainer setup-engine` скачает сборку с GitHub.
STOCKFISH_PATH=
ENGINE_DEPTH=16
ENGINE_THREADS=2
ENGINE_HASH_MB=256

# --- Пороги, в сантипешках (100 = одна пешка) ---
BLUNDER_CP=200
MISTAKE_CP=100
INACCURACY_CP=50
# Если позиция уже решена (обе оценки за/против тебя сильнее этого) — потерю не считаем ошибкой
DECIDED_CP=500

# Через запятую. bullet по умолчанию исключён. daily = заочные.
EXCLUDE_TIME_CLASSES=bullet
PROFILE_WINDOW_DAYS=30
DATA_DIR=./data
